<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- ============================================================
         VISTA FORMULARIO
         ============================================================ -->

    <record id="view_pcloud_configuracion_form" model="ir.ui.view">
        <field name="name">pcloud.configuracion.form</field>
        <field name="model">pcloud.configuracion</field>

        <field name="arch" type="xml">

            <form string="Backup pCloud">

                <!-- =================================================
                     HEADER
                     ================================================= -->

                <header>

                    <button
                        name="backup_database"
                        type="object"
                        string="Crear backup ahora"
                        class="btn-primary"
                        icon="fa-cloud-upload"
                    />

                    <button
                        name="action_connect_to_pcloud"
                        type="object"
                        string="Conectar a pCloud"
                        class="btn-secondary"
                        icon="fa-link"
                    />

                    <button
                        name="action_disconnect_from_pcloud"
                        type="object"
                        string="Desconectar"
                        class="btn-secondary"
                        icon="fa-unlink"
                    />

                    <button
                        name="create_pcloud_folder"
                        type="object"
                        string="Crear carpeta"
                        class="btn-secondary"
                        icon="fa-folder-open"
                    />

                </header>

                <sheet>

                    <!-- =================================================
                         CABECERA / IDENTIFICACIÓN
                         ================================================= -->

                    <div class="oe_title">

                        <label
                            for="name"
                            string="Configuración de backup"
                        />

                        <h1>
                            <field
                                name="name"
                                placeholder="Ej. Conexión pCloud"
                            />
                        </h1>

                        <div class="text-muted">
                            <span>Base de datos: </span>

                            <field
                                name="db_name"
                                readonly="1"
                                class="oe_inline"
                            />
                        </div>

                    </div>

                    <!-- =================================================
                         RESUMEN PRINCIPAL
                         ================================================= -->

                    <group>

                        <group string="Estado del backup">

                            <field
                                name="backup_filename"
                                string="Último archivo"
                                readonly="1"
                            />

                            <field
                                name="backup_format"
                                string="Formato"
                            />

                            <field
                                name="retention_count"
                                string="Copias a conservar"
                            />

                            <field
                                name="folder_id"
                                string="Carpeta pCloud"
                                readonly="1"
                            />

                        </group>

                        <group string="Conexión pCloud">

                            <field
                                name="hostname"
                                string="Servidor pCloud"
                                readonly="1"
                            />

                            <field
                                name="client_id"
                                string="Client ID"
                            />

                            <field
                                name="redirect_uri"
                                string="Redirect URI"
                            />

                            <field
                                name="notify_user"
                                string="Notificar resultado"
                            />

                        </group>

                    </group>

                    <!-- =================================================
                         ERROR REAL REGISTRADO
                         ================================================= -->

                    <group
                        string="Último error registrado"
                        invisible="not generated_exception"
                    >

                        <field
                            name="generated_exception"
                            readonly="1"
                            nolabel="1"
                        />

                    </group>

                    <!-- =================================================
                         PESTAÑAS
                         ================================================= -->

                    <notebook>

                        <!-- =============================================
                             ESTADO
                             ============================================= -->

                        <page
                            string="Estado"
                            name="backup_status"
                        >

                            <group>

                                <group string="Último backup">

                                    <field
                                        name="backup_filename"
                                        string="Archivo generado"
                                        readonly="1"
                                    />

                                    <field
                                        name="backup_format"
                                        string="Formato"
                                        readonly="1"
                                    />

                                    <field
                                        name="db_name"
                                        string="Base de datos"
                                        readonly="1"
                                    />

                                </group>

                                <group string="Destino">

                                    <field
                                        name="hostname"
                                        string="Servidor"
                                        readonly="1"
                                    />

                                    <field
                                        name="folder_id"
                                        string="ID carpeta pCloud"
                                        readonly="1"
                                    />

                                    <field
                                        name="retention_count"
                                        string="Copias conservadas"
                                    />

                                </group>

                            </group>

                            <separator
                                string="Notificaciones"
                            />

                            <group>

                                <group>

                                    <field
                                        name="notify_user"
                                        string="Enviar notificación"
                                    />

                                    <field
                                        name="user_id"
                                        string="Usuario"
                                        invisible="not notify_user"
                                    />

                                </group>

                            </group>

                        </page>

                        <!-- =============================================
                             CONFIGURACIÓN PCLOUD
                             ============================================= -->

                        <page
                            string="pCloud"
                            name="pcloud_configuration"
                        >

                            <group>

                                <group string="Credenciales">

                                    <field
                                        name="client_id"
                                        string="Client ID"
                                    />

                                    <field
                                        name="client_secret"
                                        string="Client Secret"
                                        password="True"
                                    />

                                    <field
                                        name="access_token"
                                        string="Access Token"
                                        password="True"
                                    />

                                </group>

                                <group string="Conexión">

                                    <field
                                        name="redirect_uri"
                                        string="Redirect URI"
                                    />

                                    <field
                                        name="hostname"
                                        string="Hostname"
                                    />

                                    <field
                                        name="folder_id"
                                        string="Folder ID"
                                        readonly="1"
                                    />

                                </group>

                            </group>

                        </page>

                        <!-- =============================================
                             CONFIGURACIÓN BACKUP
                             ============================================= -->

                        <page
                            string="Backup"
                            name="backup_configuration"
                        >

                            <group>

                                <group string="Base de datos">

                                    <field
                                        name="db_name"
                                        string="Base"
                                    />

                                    <field
                                        name="master_pwd"
                                        string="Master Password"
                                        password="True"
                                    />

                                </group>

                                <group string="Política de respaldo">

                                    <field
                                        name="backup_format"
                                        string="Formato"
                                    />

                                    <field
                                        name="retention_count"
                                        string="Copias a conservar"
                                    />

                                    <field
                                        name="notify_user"
                                        string="Notificar resultado"
                                    />

                                    <field
                                        name="user_id"
                                        string="Usuario a notificar"
                                        invisible="not notify_user"
                                    />

                                </group>

                            </group>

                        </page>

                        <!-- =============================================
                             DIAGNÓSTICO
                             ============================================= -->

                        <page
                            string="Diagnóstico"
                            name="backup_diagnostic"
                        >

                            <group>

                                <group string="Última ejecución">

                                    <field
                                        name="backup_filename"
                                        string="Último archivo generado"
                                        readonly="1"
                                    />

                                    <field
                                        name="generated_exception"
                                        string="Último error"
                                        readonly="1"
                                    />

                                </group>

                                <group string="Información técnica">

                                    <field
                                        name="db_name"
                                        string="Base de datos"
                                        readonly="1"
                                    />

                                    <field
                                        name="hostname"
                                        string="Servidor pCloud"
                                        readonly="1"
                                    />

                                    <field
                                        name="folder_id"
                                        string="Folder ID"
                                        readonly="1"
                                    />

                                    <field
                                        name="backup_format"
                                        string="Formato"
                                        readonly="1"
                                    />

                                </group>

                            </group>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>
    </record>


    <!-- ============================================================
         VISTA LISTA
         ============================================================ -->

    <record id="view_pcloud_configuracion_tree" model="ir.ui.view">
        <field name="name">pcloud.configuracion.list</field>
        <field name="model">pcloud.configuracion</field>

        <field name="arch" type="xml">

            <list string="Backups pCloud">

                <field
                    name="name"
                    string="Configuración"
                />

                <field
                    name="db_name"
                    string="Base de datos"
                />

                <field
                    name="hostname"
                    string="Servidor"
                />

                <field
                    name="backup_format"
                    string="Formato"
                />

                <field
                    name="retention_count"
                    string="Retención"
                />

                <field
                    name="backup_filename"
                    string="Último backup"
                    optional="show"
                />

                <field
                    name="generated_exception"
                    string="Último error"
                    optional="hide"
                />

            </list>

        </field>
    </record>


    <!-- ============================================================
         VISTA KANBAN
         ============================================================ -->

    <record id="view_pcloud_configuracion_kanban" model="ir.ui.view">
        <field name="name">pcloud.configuracion.kanban</field>
        <field name="model">pcloud.configuracion</field>

        <field name="arch" type="xml">

            <kanban>

                <field name="name"/>
                <field name="db_name"/>
                <field name="hostname"/>
                <field name="backup_format"/>
                <field name="retention_count"/>
                <field name="backup_filename"/>
                <field name="generated_exception"/>
                <field name="folder_id"/>
                <field name="access_token"/>

                <templates>

                    <t t-name="card">

                        <div class="p-3">

                            <!-- Nombre -->
                            <div class="d-flex justify-content-between align-items-start mb-3">

                                <div>

                                    <h4 class="mb-1">
                                        <field name="name"/>
                                    </h4>

                                    <div class="text-muted">
                                        <i class="fa fa-database me-1"/>
                                        <field name="db_name"/>
                                    </div>

                                </div>

                                <div>

                                    <t t-if="record.access_token.raw_value">

                                        <span class="badge text-bg-success">
                                            Conectado
                                        </span>

                                    </t>

                                    <t t-else="">

                                        <span class="badge text-bg-secondary">
                                            Desconectado
                                        </span>

                                    </t>

                                </div>

                            </div>

                            <!-- Servidor -->
                            <div class="mb-2">

                                <span class="text-muted">
                                    <i class="fa fa-cloud me-1"/>
                                    Servidor:
                                </span>

                                <span>
                                    <field name="hostname"/>
                                </span>

                            </div>

                            <!-- Formato -->
                            <div class="mb-2">

                                <span class="text-muted">
                                    <i class="fa fa-file-archive-o me-1"/>
                                    Formato:
                                </span>

                                <span>
                                    <field name="backup_format"/>
                                </span>

                            </div>

                            <!-- Retención -->
                            <div class="mb-2">

                                <span class="text-muted">
                                    <i class="fa fa-history me-1"/>
                                    Retención:
                                </span>

                                <span>
                                    <field name="retention_count"/>
                                    copias
                                </span>

                            </div>

                            <!-- Último archivo -->
                            <t t-if="record.backup_filename.raw_value">

                                <div class="mt-3 pt-3 border-top">

                                    <div class="text-muted small mb-1">
                                        Último backup
                                    </div>

                                    <div class="text-break">
                                        <i class="fa fa-check-circle me-1"/>
                                        <field name="backup_filename"/>
                                    </div>

                                </div>

                            </t>

                            <!-- Error -->
                            <t t-if="record.generated_exception.raw_value">

                                <div class="alert alert-danger mt-3 mb-0 py-2">

                                    <div class="fw-bold mb-1">
                                        <i class="fa fa-exclamation-triangle me-1"/>
                                        Último error
                                    </div>

                                    <div class="small text-break">
                                        <field name="generated_exception"/>
                                    </div>

                                </div>

                            </t>

                        </div>

                    </t>

                </templates>

            </kanban>

        </field>
    </record>


  


    <!-- ============================================================
         ACCIÓN
         ============================================================ -->

    <record id="action_pcloud_config" model="ir.actions.act_window">
        <field name="name">Backup pCloud</field>
        <field name="res_model">pcloud.configuracion</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="target">current</field>
    </record>


    <!-- ============================================================
         MENÚ
         ============================================================ -->

    <menuitem
        id="menu_pcloud_root"
        name="Backups"
        sequence="10"
        web_icon="backup_pcloud,static/description/icon.png"
    />

    <menuitem
        id="menu_pcloud_config"
        name="pCloud"
        parent="menu_pcloud_root"
        action="action_pcloud_config"
        sequence="10"
    />

</odoo>